# Database (MySQL)
# For Vercel + Railway, enable Railway MySQL Public Access / TCP Proxy
# and paste Railway MYSQL_PUBLIC_URL here.
DATABASE_URL="mysql://USER:PASSWORD@PUBLIC_HOST:PORT/DATABASE_NAME"

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
# Optional: if omitted, JWT_SECRET is used for refresh tokens too.
REFRESH_TOKEN_SECRET=

# App
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
NEXT_PUBLIC_API_URL=https://your-project.vercel.app/api

# Map
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token

# Vercel Blob (recommended upload fallback)
BLOB_READ_WRITE_TOKEN=

# S3 / object storage (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
NEXT_PUBLIC_S3_BASE_URL=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Redis / background jobs (optional)
REDIS_URL=

# External realtime WebSocket service (optional)
# Leave unset on Vercel unless you deploy a compatible WebSocket server.
WS_SERVER_URL=

# Weather (optional)
OPENWEATHER_API_KEY=

# Stripe (optional)
# Payments remain disabled safely when this is unset.
STRIPE_SECRET_KEY=
