# Database (MySQL)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# JWT
JWT_SECRET=change_this_to_a_long_random_secret

# Map
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token

# S3 / object storage (optional)
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=your_region
S3_BUCKET=your_bucket
# optional public base url for uploaded objects
NEXT_PUBLIC_S3_BASE_URL=https://your_bucket.s3.your_region.amazonaws.com

# SMTP (optional; saved-search notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=supersecret

# Redis (optional; rate limiter/background jobs)
REDIS_URL=redis://:password@host:6379

# App
# Set this to your deployed Vercel URL after the first deployment if the app needs an absolute API base.
NEXT_PUBLIC_API_URL=https://your-project.vercel.app/api

# Stripe / Payments (optional until payments are enabled)
# STRIPE_SECRET=
